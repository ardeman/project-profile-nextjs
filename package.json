{
  "name": "project-nextjs-profile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm export:resume && next dev",
    "build": "pnpm export:resume && next build",
    "start": "pnpx serve@latest out",
    "lint": "next lint --fix",
    "format": "prettier --write \"**/*.{js,jsx,mjs,ts,tsx}\"",
    "prepare": "husky",
    "refresh:projects": "node scripts/refresh-projects.mjs",
    "export:linkedin": "node scripts/generate-linkedin-update.mjs",
    "test:linkedin": "node --test scripts/generate-linkedin-update.test.mjs",
    "export:resume": "node scripts/generate-resume.mjs",
    "test:resume": "node --test scripts/generate-resume.test.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.1.0",
    "@fontsource/geist-sans": "^5.1.0",
    "@fontsource/oldenburg": "^5.1.0",
    "@tanstack/react-query": "^5.56.2",
    "next": "14.2.35",
    "papaparse": "^5.4.1",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^55.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^13.2.2",
    "pdf-lib": "^1.17.1",
    "postcss": "^8",
    "prettier": "2.7.0",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "packageManager": "pnpm@8.10.5",
  "engines": {
    "pnpm": "8"
  }
}
