{
  "name": "project-nextjs-profile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm export:resume && next dev --webpack",
    "build": "pnpm export:resume && next build --webpack",
    "start": "pnpx serve@latest out",
    "lint": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,mjs,ts,tsx}\"",
    "prepare": "husky",
    "refresh:projects": "node scripts/refresh-projects.mjs",
    "export:linkedin": "node scripts/generate-linkedin-update.mjs",
    "test:linkedin": "node --test scripts/generate-linkedin-update.test.mjs",
    "export:resume": "node scripts/generate-resume.mjs",
    "test:resume": "node --test scripts/generate-resume.test.mjs",
    "sync:github-profile": "node scripts/sync-github-profile.mjs",
    "test:github-profile": "node --test scripts/sync-github-profile.test.mjs",
    "lint:check": "eslint ."
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/oldenburg": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "next": "16.4.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^77.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.29",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "12"
  }
}
